# Copy to backend/.env and edit. Every value is optional.

# --- Database -------------------------------------------------------------
# Default is SQLite at backend/fitness.db. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/kinetra
# DATABASE_URL=

# --- Admin login ----------------------------------------------------------
ADMIN_USERNAME=admin
# If empty, a random password is generated on first run and printed once.
ADMIN_PASSWORD=
# JWT signing key. If empty, one is generated and saved to backend/.secret_key
SECRET_KEY=
ACCESS_TOKEN_MINUTES=60

# --- Inquiry notification email -------------------------------------------
# Where new inquiries are sent. Leave empty to skip email (they are still stored).
INQUIRY_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS on port 587 (default). For implicit TLS on 465: SMTP_USE_SSL=true, SMTP_USE_TLS=false
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Website chatbot (Google Gemini) ----------------------------------------
# Get a key at https://aistudio.google.com/apikey . Without a key the chat widget
# shows an "assistant is offline" message; the rest of the site is unaffected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Misc -----------------------------------------------------------------
# Insert realistic demo data on first run (see README to replace it with live data)
SEED_SAMPLE_DATA=true
# Expose /api/docs (Swagger UI). Keep false in production.
ENABLE_API_DOCS=false
